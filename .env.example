# ---- LLM ----
GROQ_API_KEY=""
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=5
TEMP_UPLOAD_DIR=/tmp/resumeai-uploads

# ---- CORS (comma-separated) ----
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Scoring weights (must sum to 1.0) ----
WEIGHT_SKILLS_MATCH=0.35
WEIGHT_EXPERIENCE_MATCH=0.20
WEIGHT_RESPONSIBILITIES_MATCH=0.20
WEIGHT_EDUCATION_MATCH=0.10
WEIGHT_PREFERRED_SKILLS=0.10
WEIGHT_KEYWORD_RELEVANCE=0.05
